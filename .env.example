# Generate two different long random passwords before starting Docker Compose.
POSTGRES_PASSWORD=replace-with-random-password
APP_DB_PASSWORD=replace-with-different-random-password

# Used only with compose.http.yaml for optional HTTP diagnostics.
HTTP_PORT=80

# Optional HTTPS certificate directory on the Docker host; never commit private keys.
# Example on the server: TLS_CERT_DIR=/home/eduadmin/ssl
TLS_CERT_DIR=./certs
